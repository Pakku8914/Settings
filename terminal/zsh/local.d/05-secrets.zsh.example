# ============================================================
# シークレット — 設定ファイルに平文で置かないための退避先。
# このファイルはテンプレート。install.sh が ~/.config/zsh/local.d/05-secrets.zsh にコピーするので、
# そちらに値を書く（リポジトリには絶対にコミットしない）。
# 番号 05 なので、rc.d/00-path.zsh（gh が使えるようになる）の後、oh-my-zsh の前に読まれる。
# ============================================================

# GitHub MCP プラグイン — gh CLI のトークンを流用（要 `gh auth login`）
export GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null)"

# Backlog MCP — ~/.claude.json から ${VAR} 展開で参照される
export BACKLOG_ORG_UZONE_API_KEY=""
