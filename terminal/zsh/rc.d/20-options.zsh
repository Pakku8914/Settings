# ============================================================
# シェルオプションと履歴
# 履歴のサイズは macOS の /etc/zshrc と oh-my-zsh(lib/history.zsh) も設定するので、それより後のここで上書きする
# ============================================================
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# 補完候補などで日本語のファイル名をエスケープせずに表示する
setopt print_eight_bit
