  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#434357"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#cbcbf0"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant.builtin"
      ],
      "settings": {
        "foreground": "#ff2f92"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "meta.import entity.name"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff2f92"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#00d364"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#00ceca"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.flow",
        "keyword.operator.new",
        "keyword.operator.logical.python",
        "keyword.operator.expression",
        "keyword.operator.word",
        "storage.type.function",
        "storage.type.class",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#cc66ff"
      }
    },
    {
      "scope": [
        "keyword.control.loop",
        "keyword.control.repeat",
        "storage.modifier",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#ffcc66"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#00cbff"
      }
    },
    {
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage"
      ],
      "settings": {
        "foreground": "#cc66ff"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#cbcbf0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.method-call",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#00cbff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "meta.return-type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#ffcc66"
      }
    },
    {
      "scope": [
        "meta.function-call.constructor",
        "support.class.builtin"
      ],
      "settings": {
        "foreground": "#00ceca"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "meta.attribute",
        "entity.other.attribute"
      ],
      "settings": {
        "foreground": "#ffcc66"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ffcc66"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.dict",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#bf2673"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#00d364"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#00cbff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#ff2f92"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ff2f92"
      }
    },
    {
      "scope": [
        "markup.list punctuation.definition.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#cbcbf0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#cbcbf0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#bf2673",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#cbcbf0"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00d364"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#4e4e66"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff3399"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#cbcbf0",
    "variable.defaultLibrary": "#ff2f92",
    "parameter": "#ff3399",
    "property": "#ff3399",
    "namespace": "#ff3399",
    "function": "#00cbff",
    "method": "#00cbff",
    "class": "#ffcc66",
    "type": "#ffcc66",
    "enum": "#ffcc66",
    "interface": "#ffcc66",
    "typeParameter": "#ffcc66",
    "enumMember": "#ff2f92",
    "decorator": "#ffcc66",
    "macro": "#ff3399",
    "selfParameter": "#ff2f92",
    "clsParameter": "#ff2f92",
    "*.readonly": "#ff2f92"
  }
}